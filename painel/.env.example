# Copie este arquivo para .env.local (no computador) ou cadastre no Cloudflare.
# Passo a passo em docs/PUBLICAR.md (chega na fase 6).
#
# Onde achar: Supabase ▸ projeto DO AGENTE (não o do CRM) ▸ Project Settings ▸ API (ou botão "Connect").

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO-DO-AGENTE.supabase.co

# Chave pública "anon" (projetos antigos) OU "publishable" (sb_publishable_..., projetos novos).
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# CHAVE-MESTRA que criptografa as chaves da OpenAI, da Meta e do CRM digitadas no painel.
# É SEGREDO: no Cloudflare, cadastre como "Secret" (nunca como variável comum).
# Gere uma com:  openssl rand -base64 32
# Se for perdida, as chaves salvas no painel precisam ser digitadas de novo.
CHAVE_MESTRA=

# NUNCA coloque a chave "service_role" / "secret" do Supabase aqui.
