{
	// Configuração do Cloudflare Workers (hospedagem do PAINEL do agente).
	// Cada cliente tem a sua cópia (nome, banco e segredos próprios): veja clientes/ e scripts/novo-cliente.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aurora-agente-painel",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	// global_fetch_strictly_public: o servidor não consegue abrir endereços internos (proteção da importação de páginas).
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Banco do painel (Cloudflare D1). O id é preenchido pelo assistente de novo cliente.
	"d1_databases": [
		{ "binding": "DB", "database_name": "aurora-agente", "database_id": "0a0e06bd-2913-4230-9508-6fce4c6b3533", "migrations_dir": "banco/migracoes" }
	],
	// Ligação interna com o motor do agente (simulador), sem passar pela internet.
	"services": [{ "binding": "MOTOR", "service": "aurora-motor" }],
	// Segredos (cadastrados com `wrangler secret put`, nunca aqui):
	//   CHAVE_MESTRA       cifra as chaves das integrações (openssl rand -base64 32)
	//   CODIGO_INSTALACAO  cria o 1º gestor em /instalar
	//   SEGREDO_INTERNO    o mesmo do motor (rotas /interno/*)
	"keep_vars": true,
	"observability": { "enabled": true }
}
